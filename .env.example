# ============ Bot-Verhalten ============
# Persona/Instruktionen fuer opencode (eine Zeile bleiben, keine Anfeuerungsquotes!)
PERSONA=Du bist eine echte Person. Antworte freundlich, kurz und natuerlich (max. 2 Saetze). Schreibe Deutsch. Keine Listen, keine Emoticons, keine Erwaehnung von KI oder opencode.

# Zeitfenster, in dem automatisch geantwortet wird (24h-Format HH:MM)
AUTO_REPLY_START=08:00
AUTO_REPLY_END=22:00

# Nur diese Nummern antworten (Laenderkennzahl ohne + und Leerzeichen, z. B. 491712345678). Leer = alle erlaubt.
ALLOWED_NUMBERS=

# Minimum Minuten zwischen zwei Auto-Antworten pro Chat (Loops vermeiden)
REPLY_COOLDOWN_MINUTES=10

# In Gruppen NICHT automatisch antworten
IGNORE_GROUPS=true
