# ============ Signal-Konto ============
# Eigene Signal-Nummer (Laenderkennung mit +, z. B. +491701234567)
SIGNAL_ACCOUNT=
# Pfad zur signal-cli-Binary (Standard: signal-cli)
SIGNAL_CLI_PATH=signal-cli

# ============ LLM/Brain ============
# Modus 1 (Standard): opencode-CLI als Gehirn nutzt deine vorhandene opencode-Auth.
# AI_* unten leer lassen; OPENCODE_BINARY auf das opencode-Binary zeigen.
OPENCODE_BINARY=opencode
# Modus 2 (optional, leichtgewichtig): Direkt-Call, aber eigener Key noetig:
# Azure OpenAI (bzw. OpenAI-kompatibel) Chat-Completions-Endpoint
AI_API_URL=
# API-Key (Azure: api-key Header; OpenAI-kompatibel: AI_API_AUTH=bearer)
AI_API_KEY=
# Deployment-/Modellname
AI_MODEL=deepseek-v4-flash
# Header-Authentifizierung: azure (api-key) oder bearer (Authorization)
AI_API_AUTH=azure

# ============ Bot-Verhalten ============
# Persona/Instruktionen fuer das LLM (eine Zeile bleiben, keine Anfeuerungsquotes!)
PERSONA=Du bist eine echte Person. Antworte freundlich, kurz und natuerlich (max. 2 Saetze). Schreibe Deutsch. Keine Listen, keine Emoticons, keine Erwaehnung von KI.

# Zeitfenster, in dem automatisch geantwortet wird (24h-Format HH:MM)
AUTO_REPLY_START=08:00
AUTO_REPLY_END=22:00

# Nur diese Nummern antworten (Laenderkennzahl ohne + und Leerzeichen, z. B. 491712345678). Leer = alle erlaubt.
ALLOWED_NUMBERS=

# Minimum Minuten zwischen zwei Auto-Antworten pro Chat (Loops vermeiden)
REPLY_COOLDOWN_MINUTES=10

# In Gruppen NICHT automatisch antworten
IGNORE_GROUPS=true

# Erinnerungen/Termine: Erinnerungen werden an den Signal-Chat gesendet (data/appointments.json)
SCHEDULER_ENABLED=true
